# meeting-service 公网服务器配置
# deploy.sh 首次运行会把本文件复制为 env/meeting.env 并生成随机 worker key。
# 修改后执行 ./deploy.sh restart 生效。

# ---- 必填 ----
# 模型端认领任务的凭证。留 auto 则由 deploy.sh 自动生成并回填。
MTD_WORKER_KEY=auto

# ---- 监听 ----
MTD_HOST=127.0.0.1
MTD_PORT=8000

# ---- 存储 ----
# 音频与 SQLite 落盘目录（相对仓库根目录）。建议挂独立数据盘并规划定期清理。
MTD_DATA_DIR=meeting_service_data
# 单个音频上传上限（MB）
MTD_MAX_UPLOAD_MB=500

# ---- 任务 ----
# 任务租约秒数：模型端超时未完成，任务自动重新入队
MTD_LEASE_SECONDS=3600

# ---- LLM 纪要（可选；三项全填才启用，失败不影响转写结果）----
MTD_LLM_BASE_URL=
MTD_LLM_API_KEY=
MTD_LLM_MODEL=
