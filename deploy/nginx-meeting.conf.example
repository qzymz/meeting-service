# Nginx 反向代理示例（公网部署用，配合 certbot 证书）
#   sudo cp nginx-meeting.conf.example /etc/nginx/sites-available/meeting
#   sudo ln -s /etc/nginx/sites-available/meeting /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d meeting.example.com
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name meeting.example.com;   # 改成你的域名

    # 上传音频走原始 body，放宽体积限制（与服务端 MTD_MAX_UPLOAD_MB 对齐）
    client_max_body_size 600m;

    # 长录音上传/下载耗时，放宽超时
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location / {
        proxy_pass http://127.0.0.1:8000;   # 与 MTD_PORT 对齐
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }
}
